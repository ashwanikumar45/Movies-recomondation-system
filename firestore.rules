rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profile documents - owner read/write
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Subcollection for user movie interactions (likes, watchlist, ratings)
      match /interactions/{movieId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Connection testing
    match /test/{docId} {
      allow read: if true;
    }
  }
}
